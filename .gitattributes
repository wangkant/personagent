# Text files are LF in the repository and in every checkout.
* text=auto eol=lf

# Windows scripts are CRLF: cmd.exe and some Windows Script Host locales misread LF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf

# Image / binary assets: never apply line-ending or diff conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
