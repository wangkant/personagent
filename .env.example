# ============================================================================
# REQUIRED — fill these in to get a first reply
# ============================================================================

# Primary chat model. ANY OpenAI-compatible endpoint works, hosted or a
# local ollama / llama.cpp server. This single key is all `python try_chat.py`
# needs.
LLM_API_KEY=
# Accepts a provider root, a /v1 base, or a full /chat/completions URL.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Per-request timeout (seconds) and retry budget for every /v1 call.
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2

# The bot's display name (used in prompts).
PERSONA_NAME=

# The persona document, and its optional companion card. The card carries the
# per-persona reply-style opt-ins — {"reply_style": {"emoji": true,
# "charsets": ["music"], "max_chars": 320}} — and a `[style]` block at the end
# of the persona document declares the six register knobs (length, vent, recs,
# good_news, particles, fatigue). Both are resolved relative to AGENT_HOME.
# Start from data/persona.example.<lang>.txt; until the file exists the agent
# falls back to that bundled example. Charsets: ellipsis / music / arrows;
# without a card the narrow default applies (no emoji, no optional charset).
PERSONA_FILE=persona.txt
PERSONA_CARD_FILE=persona.card.json

# Deployment root. Everything — data/ seeds, runtime/ state, the instance
# lock — is resolved under it. Unset, it is the checkout you launched from
# (or the working directory for a wheel install); AGENT_RUNTIME_DIR must stay
# beneath it. Set it to run several personas out of one installed copy.
AGENT_HOME=

# ============================================================================
# ADMIN AND ACCESS (every platform; not needed for `python try_chat.py`)
#
# Ids are "<platform>:<id>", the platform spelled as the connector names it
# (AstrBot's adapter name: telegram, discord, slack, kook, lark, ...), e.g.
# telegram:-1001234567 or discord:4242. A bare id, or qq:<id>, is a QQ number.
# ============================================================================

# The admin: the one person who runs the bot, with an account on as many
# platforms as you list. The bot is closest to them: they get the closer
# persona in groups and DMs, may manage what the bot remembers about a group,
# and may teach it on their own.
ADMIN_IDS=
ADMIN_NAME=
# Relationship label, e.g. brother / boss / friend. Blank = skip in prompts.
ADMIN_RELATIONSHIP=

# The groups the bot answers, and who besides the admin may DM it. Each
# platform is gated on its own: a platform with no entries here is not
# restricted by the agent (every QQ group is answered, a QQ DM needs the admin
# or an entry, and any other platform is left to the connector's allowlist,
# such as the AstrBot plugin's groups / dm_users). One entry for a platform
# restricts that platform to its entries. DM users get the "ordinary friend"
# persona, looser than in a group but not the admin's.
ACCESS_GROUPS=
ACCESS_DM_USERS=

# ============================================================================
# QQ AND THE ONEBOT HTTP API (not needed for `python try_chat.py`)
#
# The supported way to bring QQ in is through AstrBot (CONNECTOR_QQ_PLATFORMS
# below). The direct OneBot ingress, /v1/onebot fed by the client's webhook,
# is DEPRECATED since 0.3.0: still served, warned about once at first use,
# removed in a later release. QQ_BOT_ID / QQ_ONEBOT_URL stay in use on the AstrBot
# route: they identify the account and carry the QQ-only background actions
# (proactive sends and the catch-up sweep; the OCR fallback runs only on the
# deprecated direct ingress). Which QQ groups it answers is ACCESS_GROUPS.
# ============================================================================

# The bot account's QQ number.
QQ_BOT_ID=

# Where the agent reaches your OneBot client's HTTP API to SEND replies
# (NapCat's HTTP server). The client posts events the other way, to SERVER_PORT below.
QQ_ONEBOT_URL=http://127.0.0.1:3000

# If your OneBot client delivers received images as file:// URLs (NapCat
# local-cache mode), set this to that cache directory. The default is
# fail-closed: an empty value rejects every file:// path.
QQ_ONEBOT_IMAGE_DIR=

# Maximum decoded image size accepted from base64, file, or HTTP sources.
VISION_MAX_IMAGE_BYTES=5000000

# ============================================================================
# AGENT
# ============================================================================

# Language of the agent: en (default, primary build) or zh (Chinese variant).
# Selects the per-language data files (persona / examples / feedback /
# output_filter / lorebook -> *.en.* vs *.zh.*), the reply validator mode,
# and the control-flow lexicons.
AGENT_LANG=en

# All mutable text state (memory, evals, ledgers, replay cache, learned pools,
# and sticker metadata) is written here, never back into tracked data/.
# Relative paths are resolved from the project root. The default runtime/ is
# gitignored; if you choose another in-repository directory, add it to
# .gitignore yourself because it will contain real conversation data.
AGENT_RUNTIME_DIR=runtime

# HTTP service the OneBot client posts webhooks to.
# Loopback by default: NapCat posts events from the same machine, so the
# webhook never needs to be world-exposed. Set SERVER_HOST=0.0.0.0 only for a split
# deployment — and then also set BOTH QQ_ONEBOT_SECRET and CONNECTOR_TOKEN.
# Startup refuses a non-loopback bind if either ingress endpoint would be
# unauthenticated.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# Optional OneBot HMAC secret = the `secret` in the client's httpClient config.
# Only the deprecated direct ingress (/v1/onebot) reads it.
# When set, every /v1/onebot request body must carry a matching
# `x-signature: sha1=<hex>` header to be accepted.
QQ_ONEBOT_SECRET=
# Maximum raw body accepted by either webhook endpoint.
SERVER_MAX_BODY_BYTES=8000000
# Maximum expensive webhook requests processed concurrently. Excess requests
# receive HTTP 429 rather than consuming unbounded memory/model calls.
QQ_ONEBOT_MAX_INFLIGHT=64
# The connectors' own budget. /v1/events answers synchronously and holds its
# slot for a whole turn, while /v1/onebot releases within milliseconds — one
# shared counter let connector traffic 429 the QQ path. Blank = same as above.
CONNECTOR_MAX_INFLIGHT=

# Console-only by default. Set an absolute or protected runtime path to opt in
# to rotating file logs; logs can contain conversation-adjacent metadata. If
# the path is inside this repository, make sure it is gitignored.
SERVER_LOG_FILE=

# The persona's timezone as a UTC offset in hours (e.g. 8 = UTC+8, -5 = EST).
# Drives BOTH the time shown to the model in prompts and the 02:00-07:00
# "sleep window" that suppresses spontaneous replies at night. Defaults to 8.
PERSONA_TZ_OFFSET_HOURS=8

AGENT_ENABLED=true
CHAT_TRIGGER_COUNT=30
CHAT_CONTEXT_MESSAGES=120
CHAT_FOLLOWUP_WINDOW_S=120
MEMORY_FILE=memory.json
MEMORY_MAX_PER_CONVERSATION=50

# ============================================================================
# OPTIONAL — safe to leave blank for a first run
# ============================================================================

# --- DM model (optional) ---
# Alternate model name for DMs, served by the SAME primary OpenAI-compatible
# endpoint and key as LLM_MODEL. The one exception: the same name as
# LLM_FALLBACK_MODEL is served where the fallback is, so with
# LLM_FALLBACK_BASE_URL set, DMs go there. Blank = use LLM_MODEL for DMs too.
LLM_DM_MODEL=

# --- Web search (auto fact-lookup for unfamiliar things) ---
# With a Tavily key it uses Tavily (more reliable); blank falls back to no-key
# DuckDuckGo (needs the `ddgs` package from requirements.txt).
TAVILY_API_KEY=

# --- Self-eval (async 1-5 scoring of each reply -> eval.jsonl) ---
# Off by default so a first run is cheapest. Turn on once you start tuning.
# Tip: prefer a model from a DIFFERENT vendor than your main chat model —
# same-family self-eval is blind to its own failure modes. If EVAL_MODEL
# contains "moonshot"/"kimi", the call routes through the vision endpoint below.
EVAL_ENABLED=false
EVAL_MODEL=
EVAL_FILE=eval.jsonl

# --- Vision (image / sticker understanding) ---
# Blank = skip vision, OCR-only fallback (costs nothing). Any OpenAI-compatible
# vision model works; give it its provider's key and base URL here — there is
# no default endpoint.
VISION_MODEL=
VISION_API_KEY=
VISION_BASE_URL=

# --- Connectors (platform-neutral forwarding, e.g. the AstrBot plugin) ---
# POST /v1/events accepts messages forwarded from other platforms
# (Telegram / Discord / Slack / ...) and returns the replies in the HTTP
# response for the connector to relay back (docs/connectors.md).
# CONNECTOR_TOKEN: shared secret the connector uses for the bearer header and
# HMAC-SHA256(timestamp + "." + nonce + "." + exact JSON body). The signed
# envelope is replay-checked. Blank is acceptable only on loopback; cross-host
# forwarding requires HTTPS (or a private tunnel terminating on loopback) and
# a non-empty token. The admin's accounts are ADMIN_IDS above.
CONNECTOR_TOKEN=
# Reject events whose sent_at is older than this even when the request
# envelope itself is fresh. The default allows delayed adapter delivery for up
# to 24 h.
CONNECTOR_MAX_EVENT_AGE_S=86400
# Connector platforms whose ids arrive BARE instead of "<platform>:<id>".
# Set this to the connector's QQ adapter name (AstrBot calls it "aiocqhttp")
# to run QQ through a connector alongside every other platform: the ids stay
# spelled the way NapCat spells them, so no conversation is renamed and
# nothing already learned is orphaned. Leave blank unless you are doing that.
#
# It is an operator setting on purpose. A bare id is what the QQ entries of
# ADMIN_IDS, ACCESS_GROUPS and ACCESS_DM_USERS are compared against, so
# naming a platform here grants its connector the authority to address QQ
# conversations, which is also why the QQ entries apply to it. Only QQ's
# adapter belongs here: its ids are the QQ numbers.
CONNECTOR_QQ_PLATFORMS=
# Messages nobody asked for (proactive openers, the follow-up question after a
# rejection, the excuse when the model call fails) reach a forwarded platform
# only through a connector that polls POST /v1/outbox and said so
# ("capabilities": ["outbox"], see docs/connectors.md). false turns the outbox off:
# the endpoint answers 404 and those messages stay on QQ via NapCat, as they
# were before it existed.
CONNECTOR_OUTBOX_ENABLED=true

# --- Proactive messaging (the bot occasionally speaks first) ---
# Off by default. When on, a background loop may self-initiate a message after a
# chat has been quiet for a while (outside the sleep window), with cooldowns and
# a low probability — and the model is told to stay quiet unless it genuinely
# has something to say. Works in groups AND DMs, only with people/groups the
# bot has already seen talk this run (it never cold-opens a silent chat). On
# QQ it sends through NapCat, and DMs go only to the QQ ids in ADMIN_IDS and
# ACCESS_DM_USERS. Elsewhere it reaches a conversation only through a
# connector that pulls the outbox (CONNECTOR_OUTBOX_ENABLED above), and DMs go to anyone
# that connector let through.
PROACTIVE_ENABLED=false
# Platforms the loop may speak first on, comma-separated (qq, telegram,
# discord, ...); blank = every platform it can reach. PROACTIVE_PLATFORMS=qq
# keeps it where it was before connectors could pull the outbox.
PROACTIVE_PLATFORMS=
PROACTIVE_INTERVAL_S=1500          # how often the loop checks, seconds (25 min)
PROACTIVE_MIN_SILENCE_S=2700       # a group must be quiet this long first (45 min)
PROACTIVE_COOLDOWN_S=10800         # min seconds between group initiations (3h)
PROACTIVE_PROB=0.25              # chance per eligible tick (0-1)
PROACTIVE_DM_MIN_SILENCE_S=14400   # a DM must be quiet this long first (4h)
PROACTIVE_DM_COOLDOWN_S=86400      # min seconds between DMs to one person (24h)
PROACTIVE_DM_PROB=0.2            # chance per eligible tick (0-1)

# --- Reaction learning (learn from real user reactions — primary signal) ---
# On by default. Every sent reply briefly waits for a DIRECTED user reaction:
# a quote of the bot's message, an @/name-call, or (in a DM) the other
# person's next message. An in-process adjudicator (one cheap LLM call)
# classifies it — correction / rejection / positive / neutral — and filters
# banter and trolling.
#
# What a reaction can do: it is recorded as EVIDENCE (append-only, in
# runtime/evidence.<lang>.jsonl) and may propose a CANDIDATE. A candidate
# changes nothing until it is PROMOTED — see the promotion block below. Nothing
# here writes the retrieval pools directly. Every adjudication is also audited
# in candidates.jsonl (src=user_reaction).
REACT_LEARN_ENABLED=true
REACT_TTL_S=900         # how long a reply waits for a reaction (15 min)
REACT_MAX_PENDING=4       # replies tracked per conversation
REACT_MODEL=              # blank = LLM_JUDGE_MODEL (cheapest configured)
REACT_FIX_WINDOW_S=600      # retry-completion: how long after a rejection the
                          # bot's next reply still counts as the fix attempt
REACT_ELICIT_ENABLED=true         # after an accepted rejection, may ask (delayed,
                          # cooldown-limited) what the user actually meant
REACT_ELICIT_DELAY_S=120    # wait this long first - never talks over the bot's
                          # own normal reply to the rejection
REACT_ELICIT_COOLDOWN_S=3600  # min seconds between asks per conversation

# --- Promotion policy (when learned material may affect replies) ---
# A reaction is evidence. An adjudication creates a candidate. PROMOTION grants
# a candidate authority over future replies; rollback or supersession takes it
# away. Only promoted candidates enter few-shot retrieval, and they enter
# through runtime/promoted.{examples,feedback}.<lang>.jsonl — a view rebuilt
# from the append-only ledger, never hand-edited.
#
# The defaults exist to make one thing impossible: a single automatic signal
# permanently changing how the bot talks. Loosen them only if you are watching
# the results. Review what is waiting with:
#   python tools/candidates_admin.py list
PROMOTE_AUTO_ENABLED=true                  # false = nothing is ever promoted without you
PROMOTE_MIN_EVENTS=2               # distinct compatible events needed (floor: 2)
PROMOTE_MIN_STRONG=1               # of which this many must be STRONG (floor: 1)
PROMOTE_MIN_SPEAKERS=1             # ...from this many DISTINCT people (floor: 1)
#   MIN_EVENTS counts events, and one person can produce two: correct a reply,
#   then accept the retry. Default 1 keeps that working, because an honest
#   clarification looks exactly the same as the abuse of it. Set 2 for a room
#   where a stranger should not be able to teach the agent unaided — the admin
#   stays exempt, and a blocked candidate is still proposed for you to approve.
PROMOTE_EVIDENCE_MAX_AGE_DAYS=30   # older evidence stops counting as support; 0 = no window at all
PROMOTE_REQUIRE_SAME_CONVERSATION=true  # never combine evidence across rooms
#
# Strong  = an explicit correction from the person the reply was aimed at, with
#           a concrete replacement in it; or a retry that person then accepted.
# Weaker  = a rejection with nothing concrete in it, a correction from a
#           bystander, or the bot's own self-review. Real evidence; not a mandate.
# Weak    = laughter, agreement, banter, the bot's own score. Never promotes
#           anything, at any quantity — so positive examples are promoted by you,
#           not by the loop.
# Admin status does not substitute for being the affected recipient, and
# contradictory evidence blocks automatic promotion outright.

# --- Persona version (evidence scope) ---
# Optional label recorded on every evidence event next to a hash of your persona
# text. Editing the persona document does NOT reset what the bot has learned:
# every hash seen under one PERSONA_VERSION is the same character (the lineage
# is kept in runtime/persona_lineage.json). Change this label when you
# deliberately start a new character and want a clean slate.
PERSONA_VERSION=

# --- Self-evolution (unattended eval -> candidate learning loop) ---
# Off by default. When on, a background loop periodically takes new low-score
# entries from eval.jsonl, has a model diagnose the failure and draft a
# BAD -> OK rewrite, and files it as a preference CANDIDATE. It is not applied:
# a self-diagnosis is one automatic signal nobody witnessed, so it waits for a
# real user event to corroborate it or for you to promote it. Same pipeline with
# an interactive approval gate: python tools/auto_reviewer.py --apply
# Needs EVAL_ENABLED=true (without scores there is nothing to learn from).
EVOLVE_AUTO_ENABLED=false
EVOLVE_INTERVAL_HOURS=6   # how often to look for new low-score entries
EVOLVE_THRESHOLD=3        # score <= this counts as a miss (3 = drifting into
                          # assistant register, the band this loop exists to fix;
                          # at 2 it has nothing to learn from)
EVOLVE_BATCH=5            # max entries diagnosed per tick
EVOLVE_MODEL=             # blank = EVAL_MODEL (falls back to the chat model)

# --- Few-shot pool size (how much learned material retrieval scans) ---
# Retrieval scans the read-only data/ seeds, the learned runtime/ pools and the
# promoted views on every reply to pick the 4 examples + 6 contrastive pairs
# that go into the prompt. These caps bound the machine-written half: they size
# the promoted views, and the offline tools apply them to what they write.
# Bounding it keeps retrieval tracking the persona as it is now — material
# promoted months ago came out of an older prompt, and once it piles up it
# outvotes the recent. Raise for very varied topics; 0 = no cap.
# Nothing you wrote or approved yourself is ever counted or dropped: the data/
# seeds are read-only, rows approved through prompt_lab.py carry no machine
# marker, and pre-ledger learned rows are left exactly as they are.
PROMOTE_MAX_EXAMPLES=500     # promoted positive examples kept
PROMOTE_MAX_FEEDBACK=500     # machine-generated BAD/OK pairs kept

# --- Rate-based fallback (downgrade to a cheaper model when busy) ---
LLM_FALLBACK_MODEL=
# The fallback model's own endpoint, so an outage at the primary's provider is
# not also the fallback's. Blank = LLM_BASE_URL / LLM_API_KEY. Only a
# LLM_FALLBACK_MODEL distinct from LLM_MODEL is sent here — along with the gate,
# self-eval and reaction calls, whose models default to it. A blank key with a
# URL on another provider sends LLM_API_KEY there: give it its own key.
# Accepts the same URL spellings as LLM_BASE_URL.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
# Whether a LLM_FALLBACK_BASE_URL on another host than LLM_BASE_URL accepts
# DeepSeek's `thinking` field. false = it is never sent there: Groq and OpenAI
# answer 400 to it instead of ignoring it, and the gate, search decision and
# sticker tagger go to the fallback on every turn, not only during an outage.
# Set true for a DeepSeek, Zhipu or Moonshot fallback. A fallback on the
# primary's host is sent what the primary is sent, whatever this says.
LLM_FALLBACK_THINKING=false
LLM_RATE_WINDOW_S=120
LLM_RATE_THRESHOLD=30
LLM_FALLBACK_DURATION_S=180
# Seconds a model that answered 429 (rate-limited) is skipped. Shorter than
# LLM_FALLBACK_DURATION_S on purpose: a throttled model is metered, not broken, and
# the call that hit the 429 has already failed over. Any other failure (a 400,
# retries exhausted) still keeps the model out for LLM_FALLBACK_DURATION_S.
LLM_RATE_LIMIT_COOLDOWN_S=20

# --- Two-stage routing: cheap gate, main-model reply ---
# Self-initiated modes (judge / followup / proactive) first ask this cheapest
# model only "would a real person reply here, or stay quiet?". If it decides to
# reply, the line that's actually sent is (re)written by the main model — so the
# group never sees output from the cheap model. Blank = use LLM_FALLBACK_MODEL (or
# the main model). Point it at the cheapest model you have.
LLM_JUDGE_MODEL=

# --- Offline dev tools (not read by the bot) ---
# Nothing here affects a running deployment. They are listed because the
# startup preflight treats this file as the authority on what a setting may be
# CALLED, and an undocumented-but-real key would otherwise be reported to you
# as a typo.
#
# tools/prompt_lab.py generates through a DIFFERENT vendor than the agent under
# test — that separation is what makes the lab a measurement rather than a
# mirror. Needs `pip install -e ".[judge]"`.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# Required by the lab, with no default: name a model the vendor above serves.
LAB_MODEL=
# tools/auto_reviewer.py; falls back to EVAL_MODEL, then the chat model.
REVIEWER_MODEL=
# tools/evolution_benchmark.py --judge and tools/behavior_eval.py (its persona
# and learning suites): the scoring model, again deliberately a different
# vendor from the one being measured. BENCH_JUDGE_BASE_URL and
# BENCH_JUDGE_API_KEY default to LLM_BASE_URL and LLM_API_KEY.
BENCH_JUDGE_MODEL=
BENCH_JUDGE_API_KEY=
BENCH_JUDGE_BASE_URL=
BENCH_EVAL_DELAY_S=

# --- Ledger size warnings (operational) ---
# The evidence log and the candidate ledger are append-only and never
# truncate. These are the sizes at which each starts warning in the log; they
# do not cap or rotate anything, they only tell you to go look.
LEDGER_EVIDENCE_WARN_BYTES=
LEDGER_CANDIDATES_WARN_BYTES=
