# Matrix connector settings. Copy to .env next to matrix_connector.py, or pass
# another file with --config. Environment variables override the file.

# --- Matrix account ---
# The homeserver's client URL (https:// is assumed when left out).
MATRIX_URL=https://matrix.example.org
# Either an access token (preferred) ...
MATRIX_ACCESS_TOKEN=
# ... or a user id and password. The session a password login gets is saved
# under MATRIX_STORE_DIR and reused, so a restart is not a new device.
MATRIX_USER_ID=@nova:example.org
MATRIX_PASSWORD=
# The device the access token belongs to; needed with MATRIX_E2EE_ENABLED=true.
MATRIX_DEVICE_ID=
MATRIX_DEVICE_NAME=personagent

# --- personagent ---
# The agent's base URL; /v1/events and /v1/outbox are appended.
PERSONAGENT_URL=http://127.0.0.1:8080
# The agent's CONNECTOR_TOKEN. Required for anything but a loopback URL, and
# then the URL must be HTTPS.
CONNECTOR_TOKEN=
# A stable id for this connector; derived from the bot's user id when empty.
MATRIX_CONNECTOR_ID=
# How long one turn may take. Keep it above the agent's
# LLM_TIMEOUT_S x (1 + LLM_MAX_RETRIES).
MATRIX_TIMEOUT_S=420
# Poll the agent's outbox for openers, follow-ups and excuses.
MATRIX_OUTBOX_ENABLED=true

# --- who the bot answers ---
# Comma lists; empty answers no one. Globs work: @*:example.org is a whole
# server. A bare * is everyone, unfiltered: the agent's own ACCESS_GROUPS /
# ACCESS_DM_USERS then decide alone (prefiltered=false).
# Group rooms to answer in, by room id (!abc:example.org). * is every room
# the bot has joined.
MATRIX_GROUPS=
# People allowed to talk to the bot in a direct chat.
MATRIX_DM_USERS=
# Invites from these users are accepted. Invites to rooms listed by id in
# MATRIX_GROUPS, and direct-chat invites from MATRIX_DM_USERS, always are.
MATRIX_INVITE_FROM=
# Never answered, and not counted as members when telling a direct chat from
# a group: bridge bots, and the bridge's ghost of the bot's own account.
MATRIX_IGNORE_USERS=

# --- behaviour ---
# End-to-end encryption. Keys live in MATRIX_STORE_DIR; keep it.
MATRIX_E2EE_ENABLED=false
# The directory keys and the saved session live in (default: runtime/ next to
# the script).
MATRIX_STORE_DIR=
# Mark a message read once the agent has taken the conversation.
MATRIX_READ_RECEIPTS_ENABLED=true
# Messages older than this many seconds are history, not new messages.
MATRIX_MAX_EVENT_AGE_S=300
MATRIX_LOG_LEVEL=INFO
