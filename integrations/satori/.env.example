# Copy to integrations/satori/.env (or pass --config FILE). Variables set in the
# environment win over this file.

# The Satori server. Koishi's server-satori plugin listens on Koishi's port
# (5140) under /satori; the /v1 suffix is optional.
SATORI_URL=http://127.0.0.1:5140/satori
# server-satori's token, when it has one.
SATORI_TOKEN=

# personagent's base URL (/v1/events and /v1/outbox are appended), and the
# agent's CONNECTOR_TOKEN. Anything but a loopback URL needs https and the token.
PERSONAGENT_URL=http://127.0.0.1:8080
CONNECTOR_TOKEN=

# Which conversations are forwarded. Nothing is, until listed.
# Groups by channel or guild id, DMs by user id; an entry may be scoped to a
# platform ("telegram:-100123"). "*" forwards everything and leaves the
# decision to the agent's own allowlists.
SATORI_GROUPS=
SATORI_DM_USERS=
# Only these Satori platforms (comma-separated); empty means all.
SATORI_PLATFORMS=
# Rename a Satori platform as personagent sees it: satori_name=name, ...
# "qq" (the official QQ bot API) becomes "qqbot" unless you say otherwise.
SATORI_PLATFORM_NAMES=

# Pull scheduled openers, follow-ups and excuses from the agent's outbox.
SATORI_OUTBOX_ENABLED=true
# A stable id for this connector; derived from SATORI_URL when empty.
SATORI_CONNECTOR_ID=
# How long one turn may take. Keep it above the agent's
# LLM_TIMEOUT_S x (1 + LLM_MAX_RETRIES).
SATORI_TIMEOUT_S=420
# Download public image URLs here and send them inline, instead of passing the
# URL for the agent to fetch.
SATORI_INLINE_IMAGES_ENABLED=false
SATORI_LOG_LEVEL=INFO
